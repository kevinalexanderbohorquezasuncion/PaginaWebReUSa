<%@ include file="plantilla.jspf" %>
<%@ page import="com.reusa.modelo.Articulo,java.sql.ResultSet" %>
<% Articulo a=(Articulo)request.getAttribute("articulo"); ResultSet comentarios=(ResultSet)request.getAttribute("comentarios"); %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%=a.getNombre()%> | ReUsa</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/estilos.css"></head><body><header class="topbar"><a class="brand" href="<%=request.getContextPath()%>/">ReUsa<span>.</span></a><nav><a href="<%=request.getContextPath()%>/catalogo">Catálogo</a><% if(usuarioActual!=null){%><a href="<%=request.getContextPath()%>/logout">Salir</a><%}else{%><a href="<%=request.getContextPath()%>/login">Iniciar sesión</a><%}%></nav></header><main class="container detail-page"><a href="<%=request.getContextPath()%>/catalogo" class="back">← Volver al catálogo</a><section class="detail-card"><div class="detail-art">♻</div><div><p class="eyebrow"><%=a.getCategoria()%></p><h1><%=a.getNombre()%></h1><p class="detail-price">$<%=a.getPrecio()%></p><p><%=a.getDescripcion()==null?"":a.getDescripcion()%></p><p><b>Estado:</b> <%=a.getEstado()%></p><p><b>Vendedor:</b> <%=a.getVendedor()%></p><span class="status"><%=a.isVendido()?"Vendido":"Disponible"%></span></div></section>
<section class="comments"><h2>Preguntas y comentarios</h2><% if(usuarioActual!=null){%><form method="post" action="<%=request.getContextPath()%>/comentar"><input type="hidden" name="articuloId" value="<%=a.getId()%>"><textarea name="comentario" rows="3" maxlength="2000" placeholder="Escribe una pregunta u opinión..." required></textarea><button>Publicar comentario</button></form><%}else{%><p><a href="<%=request.getContextPath()%>/login">Inicia sesión</a> para comentar este producto.</p><%}%><div class="comment-list"><% while(comentarios.next()) { %><article class="comment"><b><%=comentarios.getString("nombre")%></b><p><%=comentarios.getString("comentario")%></p><small><%=comentarios.getTimestamp("fecha_comentario")%></small></article><% } %></div></section></main></body></html>
