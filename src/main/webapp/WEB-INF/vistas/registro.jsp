<%@ include file="plantilla.jspf" %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Crear cuenta | ReUsa</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/estilos.css"></head><body><header class="topbar"><a class="brand" href="<%=request.getContextPath()%>/">ReUsa<span>.</span></a><nav><a href="<%=request.getContextPath()%>/catalogo">Volver al catálogo</a></nav></header><main class="form-wrap"><form class="form-card" method="post" action="<%=request.getContextPath()%>/registro"><p class="eyebrow">ÚNETE A REUSA</p><h1>Crea tu cuenta</h1><p>Empieza a comprar, vender y reutilizar.</p><% if(request.getAttribute("error")!=null){ %><div class="error"><%=request.getAttribute("error")%></div><% } %><label>Nombre<input name="nombre" maxlength="100" required></label><label>Correo electrónico<input type="email" name="correo" maxlength="150" required></label><label>Contraseña<input type="password" name="clave" minlength="8" required><small>Mínimo 8 caracteres.</small></label><button class="wide">Crear cuenta</button><p class="form-foot">¿Ya tienes cuenta? <a href="<%=request.getContextPath()%>/login">Inicia sesión</a></p></form></main></body></html>
