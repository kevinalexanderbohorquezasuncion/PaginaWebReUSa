<%@ include file="plantilla.jspf" %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Publicar | ReUsa</title><link rel="stylesheet" href="<%=request.getContextPath()%>/css/estilos.css"></head><body><header class="topbar"><a class="brand" href="<%=request.getContextPath()%>/">ReUsa<span>.</span></a><nav><a href="<%=request.getContextPath()%>/catalogo">Catálogo</a></nav></header><main class="form-wrap"><form class="form-card" method="post" action="<%=request.getContextPath()%>/publicar"><p class="eyebrow">COMPARTE CON TU COMUNIDAD</p><h1>Publicar producto</h1><% if(request.getAttribute("error")!=null){ %><div class="error"><%=request.getAttribute("error")%></div><% } %><label>Nombre del producto<input name="nombre" maxlength="150" required></label><label>Categoría<select name="categoria" required><option value="">Selecciona</option><option>Tecnología</option><option>Hogar</option><option>Deportes</option><option>Ropa</option><option>Electrodomésticos</option><option>Otros</option></select></label><label>Precio en dólares<input type="number" name="precio" min="0.01" step="0.01" required></label><label>Estado<select name="estado"><option>Como nuevo</option><option selected>Bueno</option><option>Regular</option></select></label><label>Descripción<textarea name="descripcion" rows="5" maxlength="3000"></textarea></label><button class="wide">Publicar producto</button></form></main></body></html>
